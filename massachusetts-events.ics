BEGIN:VEVENT
SUMMARY:Anthony Green - Worcester
DTSTART:20260828T000000
DTEND:20260828T000000
DTSTAMP:20260827T212256Z
UID:5742b2d6cb36736ed4d4428b7ff25d@massachusetts-events
